{
  "name": "trustd-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "cargo build --manifest-path ../Cargo.toml -p localshelld-sync-server && playwright test"
  },
  "dependencies": {
    "@a1knla/cakeui": "0.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.6.2",
    "sass": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.0"
  }
}
